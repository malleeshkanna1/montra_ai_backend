```gitignore
# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Python build / distribution
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python packaging
MANIFEST
*.manifest
*.spec

# ==========================================
# Virtual Environments
# ==========================================

.venv/
venv/
env/
ENV/
virtualenv/

# ==========================================
# Environment Variables & Secrets
# ==========================================

.env
.env.*
!.env.example

# Secret / credential files
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# ==========================================
# Python Tools / Caches
# ==========================================

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.dmypy.json
.pyright/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml/

# ==========================================
# Jupyter Notebook
# ==========================================

.ipynb_checkpoints/

# ==========================================
# IDE / Editors
# ==========================================

.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Logs & Temporary Files
# ==========================================

*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ==========================================
# Database Files
# ==========================================

*.sqlite
*.sqlite3
*.db

# ==========================================
# AI / ML Generated Files
# ==========================================

# Model weights and checkpoints
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# Embeddings / vector database
chroma/
chroma_db/
vector_store/
embeddings/

# Uploaded / generated files
uploads/
generated/
media/

# ==========================================
# UV / Dependency Management
# ==========================================

# Keep uv.lock committed for reproducible installs
# uv.lock

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# Node.js (if frontend is inside this repo)
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
